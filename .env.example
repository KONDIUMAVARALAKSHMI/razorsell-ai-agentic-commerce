# RazorSell AI - environment variables
# Copy this file to .env and fill in real values for anything you want to
# override. Every variable below has a safe default that lets the project
# run with zero external accounts (mock AI provider, mock payment provider,
# local SQLite/Postgres) - see docs/security.md for what each default means.

# --- App ---
ENV=development
DEBUG=true

# --- Database (docker-compose overrides this to point at the postgres service) ---
DATABASE_URL=sqlite:///./razorsell.db

# --- Redis (optional; only used for caching/session state, never for financial records) ---
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false

# --- Merchant dashboard auth (demo-grade; see docs/security.md) ---
JWT_SECRET=change-me-to-a-long-random-value
MERCHANT_DASHBOARD_USERNAME=merchant
MERCHANT_DASHBOARD_PASSWORD=demo-password

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- AI provider: "mock" (default, no API key needed) or "gemini" ---
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Payment provider: "mock" (default, no API key needed) or "razorpay" ---
# NEVER put live/production Razorpay keys here. Test Mode keys only.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Business rules (deterministic policy - see app/guardrails/policy.py) ---
MAX_UPSELL_RECOMMENDATIONS=2
MAX_PAYMENT_RETRIES=3
RETRY_COOLDOWN_SECONDS=5
MAX_DISCOUNT_PERCENT=5.0

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=300

# --- Frontend (see frontend/.env.example) ---
# VITE_API_BASE_URL=http://localhost:8000
